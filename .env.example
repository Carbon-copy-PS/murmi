OPENAI_API_KEY=your-key-here
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_TURN_DETECTION=server_vad
OPENAI_REALTIME_VAD_THRESHOLD=0.5
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=300
OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=500
# OPENAI_REALTIME_COMMIT_SECONDS=2.0

# --- Postgres (leave POSTGRES_HOST empty to run fully in-memory) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=debate_sense
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# How long a session and all its content live (hours) before permanent deletion
SESSION_TTL_HOURS=48
# How often the expiry sweeper runs (minutes)
SESSION_PURGE_INTERVAL_MINUTES=15
# Spoken language comes from the recorder/session selection; no hidden environment override.
# The live path stores completed Realtime text directly and does not use a second pass.
# Optional prompt override (leave unset to use the neutral default):
# OPENAI_REALTIME_TRANSCRIPTION_PROMPT=Transcribe the speech faithfully in the languages actually spoken. Do not translate, summarize, or complete unfinished sentences. Do not add words when there is no speech.
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription
