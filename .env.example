OPENAI_API_KEY=your-key-here
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_TURN_DETECTION=server_vad
OPENAI_REALTIME_VAD_THRESHOLD=0.5
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=300
OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=800
OPENAI_FINAL_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# OPENAI_REALTIME_COMMIT_SECONDS=2.0
# OPENAI_REALTIME_FINAL_AUDIO_MAX_SECONDS=90
# OPENAI_FINAL_TRANSCRIPTION_PROMPT=Transcribe the user's speech exactly. Preserve English, German, Swiss German, and French as spoken. Do not translate. If there is no speech, return no text.
# Leave language unset for multilingual auto-detection, or set one ISO-639-1 code like en, de, or fr.
# OPENAI_REALTIME_LANGUAGE=en
# OPENAI_REALTIME_TRANSCRIPTION_PROMPT=Transcribe a live multilingual debate. Speakers may use English, German, Swiss German, or French. Preserve the language being spoken; do not translate. Ignore non-speech sounds and brief filler noises.
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription
